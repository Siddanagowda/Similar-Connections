# Environment Configuration for AI Prospect Discovery API

# Server Configuration
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=INFO

# LLM Providers (Google Gemini is recommended and primary)
# Get your Gemini key from: https://aistudio.google.com/
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI (if preferred or as fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search API Providers (Optional: system includes a built-in search scraper fallback)
# Tavily API key from: https://tavily.com/
TAVILY_API_KEY=

# SerpAPI key from: https://serpapi.com/
SERPAPI_API_KEY=

# Discovery and Search Settings
MAX_SEARCH_RESULTS_PER_PLATFORM=5
RELEVANCE_THRESHOLD=0.35
REQUEST_TIMEOUT_SECONDS=15
